# Dummy values so the test suite never depends on .env.local / a real
# Supabase project existing. Every Supabase-touching test mocks
# src/lib/supabase.ts (see src/test/supabaseMock.ts) -- these values only
# need to satisfy createClient()'s own URL validation at module-import
# time, since App.test.tsx's static imports pull in that module even
# though its tests never render the route that actually uses it.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=test-anon-key-not-a-real-credential
